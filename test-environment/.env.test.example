# Template for test-environment/docker-compose.test.yml's env vars.
# Copy to test-environment/.env and adjust as needed for a local run --
# docker-compose.test.yml already has the same defaults baked in via
# ${VAR:-default}, so this file is optional; it exists so every toggle is
# discoverable in one place. See README.md section 3 for what each layer
# does and how to verify it's active.

# --- Section 1: security layers ---

# 1.3 BotD (client-side detection, log-only, never blocks)
ENABLE_BOTD=true

# 1.2 Anubis: host port its proof-of-work-gated reverse proxy listens on.
# Anubis itself has no ENABLE_ANUBIS toggle -- comment its service out of
# docker-compose.test.yml to exclude it entirely.
ANUBIS_PORT=8080

# --- Section 2: structural challenges ---

# 2.2 Honeypots (hidden trap links; a hit is logged CRITICAL)
ENABLE_HONEYPOTS=true

# 2.3 Poisoned/decoy data (a hidden, stale twin of the first real post)
ENABLE_DECOY_DATA=true

# 2.1 Markup randomizer (rotates a curated subset of CSS classes)
ENABLE_MARKUP_RANDOMIZER=true
MARKUP_RANDOMIZER_INTERVAL_MINUTES=15

# 2.4 /feed + /api/feed (infinite scroll, semi-GraphQL, rate limiting)
FEED_RATE_LIMIT_THRESHOLD=20
FEED_RATE_LIMIT_WINDOW_SECONDS=60
FEED_PAGE_SIZE=10

# 2.5 Cookie-consent wall (real content absent until consent cookie set)
ENABLE_COOKIE_WALL=true

# 2.6 A/B structural variants (post container tag varies per request)
ENABLE_AB_VARIANTS=true

# 2.7 Loading-placeholder leakage (real text swapped in after a delay)
ENABLE_PLACEHOLDER_CONTENT=true
PLACEHOLDER_DELAY_MS=500

# 2.8 Shadow DOM (every other post renders inside a real, client-side
# -attached shadow root -- invisible to a plain-string HTML parser)
ENABLE_SHADOW_DOM=true

# 2.9 DOM Virtualization (/feed keeps only a bounded window of posts
# genuinely present in the DOM, evicting the oldest as new ones load)
ENABLE_DOM_VIRTUALIZATION=true
DOM_VIRTUALIZATION_WINDOW_SIZE=5

# 2.10 Login/session (/login, /feed-protected -- real POST-based login,
# single-use CSRF token, TTL-based server-side session)
SESSION_TTL_SECONDS=300
PROTECTED_FEED_PAGE_SIZE=5
PROTECTED_FEED_TOTAL_PAGES=2

# 2.11 Interstitials (/feed-interstitial -- a full-screen overlay that
# genuinely blocks further loading, not just the view, until dismissed)
INTERSTITIAL_TRIGGER=time
INTERSTITIAL_DELAY_MS=1000
INTERSTITIAL_SCROLL_PERCENT=30
INTERSTITIAL_FEED_PAGE_SIZE=5
INTERSTITIAL_FEED_TOTAL_BATCHES=3
