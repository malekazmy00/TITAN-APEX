# Copy to .env and adjust. src/settings.py reads all of these; nothing in
# the codebase should hardcode a value that belongs here.

# Logging
TITAN_LOG_LEVEL=INFO

# Storage (Phase 1: SQLite file path)
TITAN_STORAGE_PATH=data/titan_apex.sqlite3

# Scraping
TITAN_DOWNLOAD_DELAY=1.0

# Retry / backoff
TITAN_RETRY_MAX_ATTEMPTS=5
TITAN_RETRY_BASE_DELAY=1.0

# Circuit breaker (Phase 2)
TITAN_CIRCUIT_FAILURE_THRESHOLD=5
TITAN_CIRCUIT_COOLDOWN_SECONDS=60.0

# Multi-level, pattern-aware rate limiting (Phase 2, بند 7) — see
# src/middlewares/rate_limiter.py's own module docstring for the full
# design. account/ip/asn_subnet are a harmless no-op today (nothing sets
# request.meta["account_id"/"egress_ip"/"egress_asn"] yet) — safe,
# forward-compatible defaults, not numbers measured from real traffic.
TITAN_RATE_LIMIT_TARGET_MAX_REQUESTS=30
TITAN_RATE_LIMIT_TARGET_WINDOW_SECONDS=60.0
TITAN_RATE_LIMIT_ACCOUNT_MAX_REQUESTS=30
TITAN_RATE_LIMIT_ACCOUNT_WINDOW_SECONDS=60.0
TITAN_RATE_LIMIT_IP_MAX_REQUESTS=60
TITAN_RATE_LIMIT_IP_WINDOW_SECONDS=60.0
TITAN_RATE_LIMIT_ASN_MAX_REQUESTS=120
TITAN_RATE_LIMIT_ASN_WINDOW_SECONDS=60.0
# "Smart" pattern detection: below this coefficient of variation across
# at least this many recent intervals counts as a too-regular (bot-like)
# cadence, the same violation weight as exceeding a level's own count.
TITAN_RATE_LIMIT_REGULARITY_MIN_INTERVALS=5
TITAN_RATE_LIMIT_REGULARITY_CV_THRESHOLD=0.15
# Escalating backoff: this many consecutive violations (either reason)
# before a scope is actually blocked; the cooldown itself then doubles
# with each further block, capped at the max below.
TITAN_RATE_LIMIT_VIOLATION_THRESHOLD=3
TITAN_RATE_LIMIT_BACKOFF_BASE_SECONDS=30.0
TITAN_RATE_LIMIT_BACKOFF_MAX_SECONDS=1800.0
TITAN_RATE_LIMIT_VIOLATION_RESET_SECONDS=300.0

# Playwright (Phase 2) — leave unset to let Playwright auto-detect the
# browser it manages; set only if a deployment's installed Chromium
# revision doesn't match what the installed Playwright version expects.
TITAN_PLAYWRIGHT_EXECUTABLE=

# Byparr (Phase 3) — base URL of the Byparr service (docker-compose.yml).
# Leave unset to disable anti-bot solving entirely: any target with
# antibot_needed: true then falls back to a plain request (logged, not
# a crash) instead of failing the whole crawl.
TITAN_BYPARR_URL=

# Redis / task queue (Phase 4)
TITAN_REDIS_URL=redis://localhost:6379/0

# Alerting (Phase 4) — leave unset to only log CRITICAL on repeated
# failure (e.g. a circuit breaker opening); set to also POST a JSON
# payload to this webhook URL.
TITAN_ALERT_WEBHOOK_URL=

# AI analysis / Ollama (Phase 5, GPU lab machine only)
TITAN_OLLAMA_URL=http://localhost:11434
TITAN_AI_MODEL=qwen3:14b
