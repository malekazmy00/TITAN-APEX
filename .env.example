# Copy to .env and adjust. src/settings.py reads all of these; nothing in
# the codebase should hardcode a value that belongs here.

# Logging
TITAN_LOG_LEVEL=INFO

# Storage (Phase 1: SQLite file path)
TITAN_STORAGE_PATH=data/titan_apex.sqlite3

# Scraping
TITAN_DOWNLOAD_DELAY=1.0

# Retry / backoff
TITAN_RETRY_MAX_ATTEMPTS=5
TITAN_RETRY_BASE_DELAY=1.0

# Circuit breaker (Phase 2)
TITAN_CIRCUIT_FAILURE_THRESHOLD=5
TITAN_CIRCUIT_COOLDOWN_SECONDS=60.0

# Playwright (Phase 2) — leave unset to let Playwright auto-detect the
# browser it manages; set only if a deployment's installed Chromium
# revision doesn't match what the installed Playwright version expects.
TITAN_PLAYWRIGHT_EXECUTABLE=

# Byparr (Phase 3) — base URL of the Byparr service (docker-compose.yml).
# Leave unset to disable anti-bot solving entirely: any target with
# antibot_needed: true then falls back to a plain request (logged, not
# a crash) instead of failing the whole crawl.
TITAN_BYPARR_URL=
